# ── PostgreSQL (used by docker compose) ─────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stackaly
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# ── Database URLs (used by the API and sea-orm-cli) ─
DATABASE_URL=postgres://admin:changeme@localhost:5432/stackaly
TEST_DATABASE_URL=postgres://admin:changeme@localhost:5433/stackaly_test

# ── API server ──────────────────────────────────────
# The Vite proxy targets this address: keep them in sync
HOST=127.0.0.1
PORT=3000

# ── Logging ─────────────────────────────────────────
RUST_LOG=info
