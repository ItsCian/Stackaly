{
  // ── Rust ───────────────────────────────────────────
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  // Run clippy on save instead of plain `cargo check`
  "rust-analyzer.check.command": "clippy",
  // The Cargo workspace is in backend/, not at the repo root,
  // so tell rust-analyzer exactly where it is
  "rust-analyzer.linkedProjects": ["backend/Cargo.toml"],

  // ── General hygiene ────────────────────────────────
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Hide build output from the file tree and search
  "files.exclude": {
    "**/target": true
  },
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true
  }
}