# ── Rust ──────────────────────────────────────────
# No leading slash, so it matches at any depth (backend/target/)
target/
# Leftover files from rustfmt
**/*.rs.bk

# ── Front end (React + Vite + Bun) ────────────────
node_modules/
# Output of `bun run build` (Vite writes to dist/, not build/)
dist/
# Vite's convention for local-only files (e.g. vite.config.local.ts)
*.local
# Temp files from the TanStack Router generator
.tanstack/
# Test coverage reports, once you add tests
coverage/
# NOTE: do NOT ignore bun.lock (it pins exact versions)
# or src/routeTree.gen.ts (TanStack recommends committing it so
# type-checking works on a fresh clone without running Vite first)
frontend/src/paraglide/

# ── Secrets / environment ─────────────────────────
.env
# Also ignore .env.local, .env.test, etc.
.env.*
# ...but DO commit the template, so others know which vars exist
!.env.example

# ── Editors / OS ──────────────────────────────────
.idea/
.vscode/*
# Shared VS Code recommendations are worth committing
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────
*.log
